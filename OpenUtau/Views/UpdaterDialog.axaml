<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.UpdaterDialog"
        Width="400" Height="300" CanResize="False" WindowStartupLocation="CenterScreen"
        Title="Stellar OpenUTAU Pro — Update" Closing="OnClosing"
        Background="{DynamicResource BackgroundColor}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
    <TextBlock Grid.Row="0" Text="Stellar OpenUTAU Pro" FontSize="18" FontWeight="Bold"
               HorizontalAlignment="Center" Foreground="#7C6FF7" Margin="0,16"/>
    <TextBlock Grid.Row="1" Margin="0,8" TextAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
               Text="{Binding AppVersion}"/>
    <TextBlock Grid.Row="2" Margin="0,0" TextAlignment="Center" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               Text="Open source AI singing synthesis workstation"/>
    <TextBlock Grid.Row="3" Margin="0,20" TextAlignment="Center" VerticalAlignment="Center"
               Text="{Binding UpdaterStatus}" FontWeight="Bold"
               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10"
                HorizontalAlignment="Center" Spacing="16">
      <Button Width="100" CornerRadius="6" Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
              Content="{DynamicResource updater.github}" Command="{Binding OnGithub}"/>
      <Button Width="100" CornerRadius="6" Background="{DynamicResource AccentBrush1}" Foreground="White"
              Content="{DynamicResource updater.update}" Command="{Binding OnUpdate}"
              IsEnabled="{Binding UpdateAvailable}"
              FontWeight="{Binding UpdateButtonFontWeight}"/>
    </StackPanel>
  </Grid>
</Window>
