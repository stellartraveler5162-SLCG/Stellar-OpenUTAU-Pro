<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <Color x:Key="BackgroundColor">#0C0C12</Color>
  <Color x:Key="BackgroundColorPointerOver">#1C1C2A</Color>
  <Color x:Key="BackgroundColorPressed">#282840</Color>
  <Color x:Key="BackgroundColorDisabled">#181820</Color>

  <Color x:Key="ForegroundColor">#E4E4EE</Color>
  <Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPressed">#C4C4D4</Color>
  <Color x:Key="ForegroundColorDisabled">#686878</Color>

  <Color x:Key="BorderColor">#282840</Color>
  <Color x:Key="BorderColorPointerOver">#3C3C5A</Color>

  <Color x:Key="SystemAccentColor">#7C6FF7</Color>
  <Color x:Key="SystemAccentColorLight1">#A898FF</Color>
  <Color x:Key="SystemAccentColorDark1">#5A4FCF</Color>

  <Color x:Key="NeutralAccentColor">#3A3A50</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#4E4E68</Color>
  <Color x:Key="AccentColor1">#7C6FF7</Color>
  <Color x:Key="AccentColor2">#FF679D</Color>
  <Color x:Key="AccentColor3">#E62E6E</Color>

  <Color x:Key="TickLineColor">#1E1E30</Color>
  <Color x:Key="BarNumberColor">#686878</Color>
  <Color x:Key="FinalPitchColor">#9E9EAC</Color>
  <Color x:Key="TrackBackgroundAltColor">#10101A</Color>

  <Color x:Key="WarningColor">#3D3520</Color>

  <Color x:Key="WhiteKeyColorLeft">#141420</Color>
  <Color x:Key="WhiteKeyColorRight">#141420</Color>
  <Color x:Key="WhiteKeyNameColor">#9E9EAC</Color>

  <Color x:Key="CenterKeyColorLeft">#201E2E</Color>
  <Color x:Key="CenterKeyColorRight">#201E2E</Color>
  <Color x:Key="CenterKeyNameColor">#7C6FF7</Color>

  <Color x:Key="BlackKeyColorLeft">#0C0C12</Color>
  <Color x:Key="BlackKeyColorRight">#0C0C12</Color>
  <Color x:Key="BlackKeyNameColor">#686878</Color>

  <Color x:Key="SurfaceColor">#181A24</Color>
  <Color x:Key="SurfaceRaisedColor">#20223C</Color>
  <Color x:Key="PanelBorderColor">#24244A</Color>
  <Color x:Key="TitleBarColor">#0C0C18</Color>
  <Color x:Key="TransportBgColor">#141424</Color>
  <Color x:Key="SidebarColor">#10101C</Color>
  <Color x:Key="EditorBgColor">#161620</Color>

  <Color x:Key="GlassOverlayColor">#14FFFFFF</Color>
  <Color x:Key="GlassBorderColor">#22FFFFFF</Color>
  <Color x:Key="GlassGlowColor">#187C6FF7</Color>
  <Color x:Key="GlassShadowColor">#0C000000</Color>
  <Color x:Key="CardBgColor">#1E1E32</Color>
  <Color x:Key="CardBorderColor">#2A2A50</Color>
  <Color x:Key="ButtonHoverGlowColor">#207C6FF7</Color>
</ResourceDictionary>
