<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">true</system:Boolean>

  <Color x:Key="BackgroundColor">#0E0E12</Color>
  <Color x:Key="BackgroundColorPointerOver">#1E1E28</Color>
  <Color x:Key="BackgroundColorPressed">#2A2A36</Color>
  <Color x:Key="BackgroundColorDisabled">#181820</Color>

  <Color x:Key="ForegroundColor">#E8E8EC</Color>
  <Color x:Key="ForegroundColorPointerOver">#FFFFFF</Color>
  <Color x:Key="ForegroundColorPressed">#C8C8D0</Color>
  <Color x:Key="ForegroundColorDisabled">#6E6E7A</Color>

  <Color x:Key="BorderColor">#2A2A32</Color>
  <Color x:Key="BorderColorPointerOver">#3E3E4A</Color>

  <Color x:Key="SystemAccentColor">#7C6FF7</Color>
  <Color x:Key="SystemAccentColorLight1">#9B8FFF</Color>
  <Color x:Key="SystemAccentColorDark1">#5A4FCF</Color>

  <Color x:Key="NeutralAccentColor">#3E3E4A</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#505060</Color>
  <Color x:Key="AccentColor1">#7C6FF7</Color>
  <Color x:Key="AccentColor2">#FF679D</Color>
  <Color x:Key="AccentColor3">#E62E6E</Color>

  <Color x:Key="TickLineColor">#22222A</Color>
  <Color x:Key="BarNumberColor">#6E6E7A</Color>
  <Color x:Key="FinalPitchColor">#9E9EAC</Color>
  <Color x:Key="TrackBackgroundAltColor">#141418</Color>

  <Color x:Key="WarningColor">#3D3520</Color>

  <Color x:Key="WhiteKeyColorLeft">#16161C</Color>
  <Color x:Key="WhiteKeyColorRight">#16161C</Color>
  <Color x:Key="WhiteKeyNameColor">#9E9EAC</Color>

  <Color x:Key="CenterKeyColorLeft">#22202A</Color>
  <Color x:Key="CenterKeyColorRight">#22202A</Color>
  <Color x:Key="CenterKeyNameColor">#7C6FF7</Color>

  <Color x:Key="BlackKeyColorLeft">#0E0E12</Color>
  <Color x:Key="BlackKeyColorRight">#0E0E12</Color>
  <Color x:Key="BlackKeyNameColor">#6E6E7A</Color>

  <Color x:Key="SurfaceColor">#1A1A20</Color>
  <Color x:Key="SurfaceRaisedColor">#22222C</Color>
  <Color x:Key="PanelBorderColor">#2A2A32</Color>
  <Color x:Key="TitleBarColor">#0E0E12</Color>
  <Color x:Key="TransportBgColor">#16161C</Color>
  <Color x:Key="SidebarColor">#141418</Color>
  <Color x:Key="EditorBgColor">#18181E</Color>
</ResourceDictionary>
